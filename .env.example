# FileEngine Provisioning Service configuration. Copy to .env and adjust.
# Never commit .env. Shared cross-service keys keep the FILEENGINE_* prefix;
# service-private keys use PROV_*.

# --- gRPC core (SHARED) ---
FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051

# --- Redis (SHARED) — audit stream emission ---
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=
FILEENGINE_REDIS_DB=0
FILEENGINE_AUDIT_STREAM=fileengine:audit

# --- Auth (SHARED) — one HS256 secret verifies the bridge/integration token ---
FILEENGINE_JWT_SECRET=

# --- LDAP (SHARED) — identity/role resolution ---
FILEENGINE_LDAP_ENDPOINT=ldap://localhost:1389
FILEENGINE_LDAP_DOMAIN=dc=rationalboxes,dc=com
FILEENGINE_LDAP_USER_BASE=ou=users,dc=rationalboxes,dc=com
FILEENGINE_LDAP_TENANT_BASE=ou=tenants,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_DN=cn=admin,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_PASSWORD=

# --- HTTP (service-private) ---
PROV_HTTP_HOST=127.0.0.1
PROV_HTTP_PORT=8100
# Server-to-server API; normally NO browser CORS. Leave empty unless a trusted
# admin origin needs the template editor cross-origin.
PROV_CORS_ORIGINS=

# --- Postgres (service-private; owns its own DB) ---
PROV_PG_HOST=localhost
PROV_PG_PORT=5434
PROV_PG_USER=postgres
PROV_PG_PASSWORD=postgres
PROV_PG_DATABASE=provisioning
PROV_DB_STATEMENT_TIMEOUT_MS=15000
# Optional read replica (read-mostly list/inspect)
PROV_PG_REPLICA_ENABLED=false
PROV_PG_REPLICA_HOST=
PROV_PG_REPLICA_PORT=5434
PROV_PG_REPLICA_USER=
PROV_PG_REPLICA_PASSWORD=
PROV_PG_REPLICA_DATABASE=

# --- Auth fallback + acting identity ---
# Bridge introspection fallback used when FILEENGINE_JWT_SECRET is unset.
PROV_BRIDGE_URL=http://localhost:8090
PROV_BRIDGE_INTROSPECT_TTL=30
# Role attached when acting on the core AS an integration principal.
PROV_PROVISIONING_ROLE=provisioning

# --- Source-IP enforcement (defense-in-depth) ---
# Trusted edge proxies whose X-Forwarded-For is honored for client-IP derivation.
PROV_TRUSTED_PROXIES=127.0.0.1,::1
# Reject a request whose derived client IP is outside the token's aip allow-list.
PROV_ENFORCE_AIP=true
# Optional deployment-level backstop allow-list (in addition to the token aip).
PROV_IP_ALLOWLIST=

# --- Limits / safety ---
PROV_MAX_TREE_NODES=500
PROV_MAX_TREE_DEPTH=12
PROV_APPLY_RATE_PER_MIN=60
PROV_ALLOW_SPACE_DELETE=true

# --- Monitoring (loopback-only /healthz /readyz /poolz) ---
PROV_MONITORING_ALLOW_IPS=127.0.0.1,::1
